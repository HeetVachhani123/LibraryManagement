@model LMSystem.Models.StudentIndexViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="row mt-3 px-2 align-items-center">
    <div class="col-md-6">
        <a class="btn btn-primary" href="/Students/Create">Add New Student</a>
    </div>
    <!-- Search Interface Block -->
    <div class="col-md-6">
        <form method="get" action="/Students/Index" class="d-flex float-end">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control me-2" placeholder="Search by name, email, phone..." style="width: 250px;" />
            <button type="submit" class="btn btn-outline-success me-1">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="/Students/Index" class="btn btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="table-responsive rounded-4 border" style="border-color: var(--border-color) !important; overflow: hidden;">
<table class="table-premium mb-0">
    <thead>
        <tr>
            <th>StudentID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Students.Count > 0)
        {
            @foreach (var item in Model.Students)
            {
                <tr>
                    <td>@item.StudentID</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>
                        <a class="btn btn-warning btn-sm" href="/Students/Edit/@item.StudentID">Edit</a>
                        <a class="btn btn-danger btn-sm" href="/Students/Delete/@item.StudentID" onclick="return confirm('Are you sure?')">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No student records found matching the criteria.</td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Pagination Controls -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Student management page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <!-- Previous Button -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Students/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage - 1)">Previous</a>
            </li>
            <!-- Page Number Links -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Students/Index?searchTerm=@Model.SearchTerm&page=@i">@i</a>
                </li>
            }
            <!-- Next Button -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Students/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
