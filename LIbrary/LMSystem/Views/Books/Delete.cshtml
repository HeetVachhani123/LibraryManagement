@model LMSystem.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="card border-danger shadow">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Delete Confirmation</h4>
    </div>
    <div class="card-body">
        <h5 class="card-title text-danger">Are you sure you want to delete this book?</h5>
        <hr />
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Author</dd>
            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Model.ISBN</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success">Available</span>
                }
                else
                {
                    <span class="badge bg-danger">Borrowed</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
