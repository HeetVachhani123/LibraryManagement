@model LMSystem.Models.LibrarianIndexViewModel
@{
    ViewData["Title"] = "Librarians";
}

<div class="d-flex justify-content-between align-items-center mt-3 px-2">
    <a class="btn btn-primary" href="/Librarians/Create">Add New Librarian</a>
    
    <!-- Inline Search Form -->
    <form method="get" action="/Librarians/Index" class="d-flex gap-2">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name..." style="width: 250px;" />
        <button type="submit" class="btn btn-secondary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a href="/Librarians/Index" class="btn btn-outline-danger">Clear</a>
        }
    </form>
</div>

<div class="table-responsive rounded-4 border" style="border-color: var(--border-color) !important; overflow: hidden;">
<table class="table-premium mb-0">
    <thead>
        <tr>
            <th>LibrarianID</th>
            <th>Name</th>
            <th>Age</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Librarians.Any())
        {
            @foreach (var item in Model.Librarians)
            {
                <tr>
                    <td>@item.LibrarianID</td>
                    <td>@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Phone</td>
                    <td>
                        <a class="btn btn-warning btn-sm" href="/Librarians/Edit/@item.LibrarianID">Edit</a>
                        <a class="btn btn-danger btn-sm" href="/Librarians/Delete/@item.LibrarianID" onclick="return confirm('Are you sure?')">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No records found.</td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Pagination Controls -->
@if (Model.TotalPages > 1)
{
    <nav class="ms-2">
        <ul class="pagination">
            <!-- Previous Button -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Librarians/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage - 1)">Previous</a>
            </li>
            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Librarians/Index?searchTerm=@Model.SearchTerm&page=@i">@i</a>
                </li>
            }
            <!-- Next Button -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Librarians/Index?searchTerm=@Model.SearchTerm&page=@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
