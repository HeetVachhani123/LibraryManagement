@model LMSystem.Models.Librarian

@{
    ViewData["Title"] = "Delete Librarian";
}

<div class="card border-danger shadow">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Delete Confirmation</h4>
    </div>
    <div class="card-body">
        <h5 class="card-title text-danger">Are you sure you want to delete this librarian?</h5>
        <hr />
        <dl class="row mb-0">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@Model.LibrarianID</dd>
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@Model.Name</dd>
            <dt class="col-sm-2">Age</dt>
            <dd class="col-sm-10">@Model.Age</dd>
            <dt class="col-sm-2">Phone</dt>
            <dd class="col-sm-10">@Model.Phone</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="LibrarianID" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
