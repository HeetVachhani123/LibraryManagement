@model IEnumerable<LMSystem.Models.Publication>
@{
    string currentType = ViewData["CurrentType"]?.ToString() ?? "Newspaper";
    ViewData["Title"] = currentType + " Management";
    int pageNumber = (int)(ViewData["PageNumber"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<!-- Top Action Bar Matching Your UI Blueprint -->
<div class="d-flex justify-content-between align-items-center my-3">
    <a asp-action="Create" asp-route-type="@currentType" class="btn btn-premium">Add New @currentType</a>
    
    <form asp-action="Index" method="get" asp-route-type="@currentType" class="form-inline d-flex gap-2">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control form-control-premium search-pill" placeholder="Search..." />
        <button type="submit" class="btn btn-premium">Search</button>
    </form>
</div>

<!-- Main Table Layout -->
<div class="table-responsive rounded-4 border" style="border-color: var(--border-color) !important; overflow: hidden;">
<table class="table-premium mb-0">
    <thead>
        <tr>
            <th>Title</th>
            <th>Publisher</th>
            <th>Published Date</th>
            <th>Availability</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Publisher</td>
                <td>@item.PublishDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge-status @(item.IsAvailable ? "badge-available" : "badge-unavailable")">
                        @(item.IsAvailable ? "Available" : "Checked Out")
                    </span>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.ID" asp-route-type="@currentType" class="btn btn-sm btn-outline-premium border-0" title="Edit"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.ID" asp-route-type="@currentType" class="btn btn-sm btn-outline-premium border-0 text-danger" title="Delete"><i class="bi bi-trash3"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Pagination Footers Matching UI Layout Blueprint -->
<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-type="@currentType" 
                   asp-route-searchString="@ViewData["CurrentFilter"]" 
                   asp-route-pageNumber="@i">@i</a>
            </li>
        }
    </ul>
</nav>
